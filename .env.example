# Mattermost MCP Server configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Required ---
MM_URL=mattermost.mycompany.com
MM_TOKEN=

# --- Connection (defaults shown) ---
MM_SCHEME=https
MM_PORT=443

# --- TLS / SSL ---
# Default true. Set to "false" ONLY for local dev with self-signed certs.
MM_VERIFY_SSL=true
# Path to a custom CA bundle for corporate private CAs (preferred over MM_VERIFY_SSL=false).
# MM_CA_BUNDLE=/etc/ssl/certs/company-ca.pem

# --- Safety / auditing ---
# Comma-separated channel NAMES (not IDs) that the MCP server will refuse to read.
# MM_BLOCKED_CHANNELS=hr-private,exec-only

# Audit log location. Defaults to ~/.mattermost-mcp/audit.log if unset.
# MM_AUDIT_LOG_PATH=/var/log/mattermost-mcp/audit.log
